# Phase 12 test environment overrides.
#
# tests/setup/global-setup.js merges this on top of .env — only
# DATABASE_URL and TEST_PORT need to differ; secrets, seed admin
# credentials, etc. are inherited from .env.
#
# DATABASE_URL should point at the SAME Postgres server as your regular
# .env, just with a different `schema` — a lightweight, fully isolated
# set of tables for the test suite to freely reset/seed, without ever
# touching the dev database's `public` schema (or whatever the dev
# DATABASE_URL is a set to).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacy_db?schema=test"

# Port the test suite's own `next dev` instance runs on — separate from
# your regular dev server (usually 3000) so both can run at once.
TEST_PORT="3099"

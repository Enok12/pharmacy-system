# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacy_db?schema=public"

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
APP_NAME="MedCare Pharmacy"

# ── Auth (Phase 2) ──────────────────────────────────────────────────────
# Separate secrets for access vs. refresh tokens so a leaked access token
# alone can't be used to mint new refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Both must be at least 32 characters — lib/env.js refuses to start the
# server otherwise (Phase 11; the command above produces 64).
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Seed admin account created by `npx prisma db seed` (Phase 2 bootstrap —
# there's no signup flow, so this is the only way to get a first user in).
SEED_ADMIN_NAME="System Admin"
SEED_ADMIN_EMAIL="admin@medcare.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL="info"
